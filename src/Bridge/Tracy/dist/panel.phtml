<?php declare(strict_types=1);

use Raneomik\NetteMercure\Bridge\DI\Config\ConfigurationRegistry;
use Raneomik\NetteMercure\Bridge\Tracy\Value\HubData;
use Raneomik\NetteMercure\Core\Publish\Tracy\Value\BroadcastStatus;
use Tracy\Debugger;
use Tracy\Dumper;
use Tracy\Helpers;

/**
 * @var $icon string
 * @var $css string dist/panel.css, inlined: Tracy's "window" mode only copies the panel content
 * @var $cookies array<string, array{name: string, payload: ?string}> hub name => authorization cookie, its token payload when this response sets it
 * @var $isLive bool the bar of a page, not an AJAX or redirect row
 * @var $hubData HubData
 * @var $hubsConfig ConfigurationRegistry
 * @var $transports array<string, string> hub name => hub class short name
 * @var $nonce string
 */

$e = static fn (mixed $value): string => Helpers::escapeHtml((string) $value);
$ms = static fn (float $seconds): string => sprintf('%.2f ms', $seconds * 1000);
$bytes = static fn (float $size): string => $size < 1024
    ? sprintf('%d B', $size)
    : sprintf('%.1f kB', $size / 1024);
// topics or matchers ({urlpattern: [...]})
$list = static fn (array $items): string => array_is_list($items) && $items === array_filter($items, is_string(...))
	? implode(', ', $items)
	: Helpers::jsonEncode($items);
$lifetime = static fn (?int $seconds): string => match ($seconds) {
	null => 'never expires',
	0 => 'session.cookie_lifetime, or 3600 s',
	default => $seconds . ' s',
};
$hubCount = iterator_count($hubsConfig->getIterator());
?>
<style class="tracy-debug"><?= $css ?></style>

<h1 style="display: flex; align-items: center; gap: 10px;">
	<span style="width: 28px; height: 28px;"><?= $icon ?></span>
	<span>Mercure</span>
</h1>

<div class="tracy-inner">
	<div class="tracy-inner-container mercure">

		<section class="mercure-section">
			<header>
				<h2>Published</h2>
				<?php if ($hubData->hasData()): ?>
					<small><?= $hubData->messageCount ?> message<?= 1 === $hubData->messageCount ? '' : 's' ?></small>
					<?php if ($hubData->errorCount): ?><small class="mercure-failure"><?= $hubData->errorCount ?> failed</small><?php endif ?>
					<small title="memory: <?= $e($bytes($hubData->totalMemory)) ?>"><?= $e($ms($hubData->totalDuration)) ?> · <?= $e($bytes($hubData->totalSize)) ?></small>
				<?php endif ?>
			</header>
			<div class="mercure-body">
				<?php if (! $hubData->hasData()): ?>
					<p class="mercure-muted">Nothing published by this request.</p>
				<?php else: ?>
					<ul class="mercure-sent">
						<?php foreach ($hubData as $hubDatum): ?>
							<?php foreach ($hubDatum->broadcastData as $message): ?>
								<?php
								$info = $message->jsonSerialize();
								$failed = BroadcastStatus::Error === $message->status;
								$what = $info['action']
									? $info['action'] . ($info['target'] ? ' → #' . $info['target'] : '')
									: ($info['type'] ?? implode(', ', $message->topics));
								$meta = array_filter([
									$hubCount > 1 ? $hubDatum->hubName : null,
									$info['action'] || $info['type'] ? implode(', ', $message->topics) : null,
									$info['private'] ? 'private' : null,
									$info['template'],
									$bytes($message->size),
								]);
								?>
								<li class="mercure-message<?= $failed ? ' mercure-failed' : '' ?>">
									<div class="mercure-message-title">
										<b><?= $e($what) ?></b>
										<small><?= $e($ms($message->duration)) ?></small>
									</div>
									<div class="mercure-meta"><?= $e(implode(' · ', $meta)) ?></div>
									<?php if ($message->error): ?>
										<div class="mercure-meta mercure-failure"><?= $e($message->error::class) ?>: <?= $e($message->error->getMessage()) ?></div>
									<?php endif ?>
									<?= Dumper::toHtml($message->renderedData() ?? $message->data, [Dumper::COLLAPSE => true, Dumper::THEME => Debugger::$dumpTheme]) ?>
								</li>
							<?php endforeach ?>
						<?php endforeach ?>
					</ul>
				<?php endif ?>
			</div>
		</section>

		<?php if ($isLive): ?>
		<section class="mercure-section">
			<header>
				<h2>Live</h2>
				<small>connections of the page, events of every publisher</small>
			</header>
			<div class="mercure-body">
				<div id="tracy-mercure-connections"></div>
				<div id="tracy-mercure-live" class="mercure-live-log">
					<div class="mercure-live-placeholder">Waiting for events&hellip;</div>
				</div>
			</div>
		</section>
		<?php endif ?>

		<section class="mercure-section">
			<header>
				<h2>Hub<?= 1 === $hubCount ? '' : 's' ?></h2>
			</header>
			<div class="mercure-body">
				<?php foreach ($hubsConfig as $hubName => $config): ?>
					<details class="mercure-hub"<?= 1 === $hubCount ? ' open' : '' ?>>
						<summary><b><?= $e($hubName) ?></b> <small><?= $e($config->publicUrl) ?></small></summary>
						<dl class="mercure-config">
							<?php foreach ([
								'Publish URL' => $config->hubUrl,
								'Public URL' => $config->publicUrl,
								'Transport' => $transports[$hubName] ?? '–',
								'Protocol' => $config->protocolVersion->value,
								'Publish' => $list($config->publish),
								'Subscribe' => $list($config->subscribe),
								'Token lifetime' => $lifetime($config->lifetime),
								'Discovery' => $config->autoDiscovery ? 'Link header sent' : 'off',
								'Cookie' => $cookies[$hubName]['name'] . (
									null === $cookies[$hubName]['payload']
										? ': not set by this response'
										: ': set by this response, ' . $cookies[$hubName]['payload']
								),
								'Claims' => Helpers::jsonEncode($config->claims->toArray()),
							] as $label => $value): ?>
								<dt><?= $e($label) ?></dt><dd><?= $e($value) ?></dd>
							<?php endforeach ?>
						</dl>
					</details>
				<?php endforeach ?>
			</div>
		</section>

	</div>
</div>
<script<?= $nonce ?>>if (!window.tracyMercureEventLoader) window.opener?.tracyMercureEventLoader?.adopt(document);</script>

use Tracy\Dumper;

$formatData = fn(float $number, string $type): string => match($type) {
    'duration' => sprintf('%.2f ms', $number * 1000),
    'memory' => sprintf('%.2f kB', $number / 1024),
    'size' => $number < 1024 ? sprintf('%d B', $number) : sprintf('%.1f kB', $number / 1024),
};

/**

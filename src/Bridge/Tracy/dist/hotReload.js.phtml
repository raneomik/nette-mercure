<?php declare(strict_types=1);

/**
 * @var $hotReloadUrl string
 */

?>
'use strict';

(function() {
    if (window.tracyFrankenPhpHotReload) return;
    window.tracyFrankenPhpHotReload = true;

    const meta = document.createElement('meta');
    meta.name = 'frankenphp-hot-reload:url';
    meta.content = <?= Tracy\Helpers::jsonEncode($hotReloadUrl, true) ?>;

    const script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm';
    script.type = 'module';

    document.head.appendChild(meta);
    document.head.appendChild(script);
})();

{
  "$schema": "vendor/infection/infection/resources/schema.json",
  "testFramework": "tester",
    "source": {
        "directories": [
            "src"
        ],
    },
    "logs": {
        "text": "tests/reports/infection.log",
        "html": "tests/reports/infection.html",
        "summary": "tests/reports/infection-summary.log",
        "stryker": {
            "report": "main"
        }
    },
    "mutators": {
        "@default": true
    },
    "threads": "max",
    // above it, a mutant is skipped without running: its tests add up to more than 10s (the default) on CI runners
    "timeout": 60,
}
